# Copy to .env and fill in real values:  copy .env.example .env
# Active environment (loads .env.{APP_ENV} on top of .env if that file exists)
APP_ENV=development

# Inbound API auth for 3rd-party clients (X-API-Key header)
API_AUTH_ENABLED=true
API_KEYS=sk_vWOiAbHQ3U_ounGpZJ6MqBCI4mf7zHiUPBhKWbEEy9M

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sri_demo

ELASTICSEARCH_URL=https://your-deployment.elastic-cloud.com:443
ELASTICSEARCH_API_KEY=your_base64_encoded_api_key_here
ELASTICSEARCH_INDEX=documents

TIKA_ENDPOINT=http://localhost:9998/tika

# PDF OCR via Tika (requires apache/tika:latest-full with Tesseract)
TIKA_PDF_OCR_ENABLED=false
TIKA_OCR_LANGUAGE=eng+ind
TIKA_OCR_MAX_FILE_SIZE=52428800

MIN_PDF_TEXT_CHARS=50

# Local archive: storage/documents/{year}/{YYYYMMDD}/...
DOCUMENT_STORAGE_ROOT=storage/documents

# Logging (terminal + logs/app.log under project root)
# Daftar origin yang diizinkan akses CORS (comma-separated). Default cocok untuk Next.js dev.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

LOG_DIR=logs
LOG_LEVEL=INFO
LOG_ROTATION=daily
LOG_BACKUP_COUNT=30
LOG_MAX_BYTES=10485760
